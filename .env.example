# Copy this file to .env and fill in the keys you need. .env is gitignored.
#
# NEVER put a real key in THIS file -- it is tracked by git and committing it would
# publish the secret. Real values belong in .env only.
#
# The benchmark runs entirely on free tiers. No paid key is required to reproduce it.

# Primary provider. Free key: https://console.groq.com
# Free tier at time of writing: 30 req/min, 1,000 req/day, 200,000 tokens/day.
GROQ_API_KEY=

# Second provider, used for the cross-model robustness check.
# Free key: https://aistudio.google.com/apikey
# NOTE: Google's free tier may use submitted prompts and responses to improve their
# products. The warehouse is a public dataset and the questions are synthetic, so
# nothing confidential is at stake -- but this is why Gemini is the secondary provider.
GEMINI_API_KEY=

# Optional and NOT free tier: every call is billed. The Anthropic path is kept working
# so it can be swapped back in, but it is not needed for a $0 reproduction.
ANTHROPIC_API_KEY=
