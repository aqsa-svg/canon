# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# secrets
.env

# streamlit: secrets.toml holds real keys, exactly like .env. Ignored as a directory
# rather than as one filename, so a config.toml or a future secrets file cannot be
# committed by accident either.
.streamlit/

# data: large, downloaded, and reproducible via scripts/load_data.py
data/raw/
data/*.duckdb
data/*.duckdb.wal

# benchmark run outputs (results are committed deliberately, not incidentally)
benchmark/runs/

# benchmark run outputs are reproducible from the cache; the report is committed by hand
benchmark/runs/
data/llm_cache/
data/quota_ledger.json

# intermediate frames from scripts/record_demo.py; the mp4/gif are committed, these are not
docs/_frames/
docs/_check/
